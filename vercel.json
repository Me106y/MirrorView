{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd web && npm ci && npm run build && cd .. && bash scripts/sync_api_runtime.sh",
  "outputDirectory": "web/dist",
  "functions": {
      "api/index.py": {
        "maxDuration": 120,
        "includeFiles": "api/**",
        "excludeFiles": ".conda/**"
      }
  },
  "redirects": [
    {
      "source": "/api/auth/github/callback",
      "destination": "/oauth/github/callback",
      "permanent": false
    },
    {
      "source": "/api/(.*)",
      "destination": "/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/resume-match",
      "destination": "/index.html"
    },
    {
      "source": "/resume-craft",
      "destination": "/index.html"
    },
    {
      "source": "/cover-letter",
      "destination": "/index.html"
    },
    {
      "source": "/mock-interview",
      "destination": "/index.html"
    },
    {
      "source": "/job-hunt",
      "destination": "/index.html"
    },
    {
      "source": "/legal/(.*)",
      "destination": "/index.html"
    }
  ]
}
