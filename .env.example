# MirrorView environment template
# Copy this file to .env and replace the placeholder values as needed.

# Default AI provider. Supported providers include deepseek, openai, and anthropic.
PLATFORM_PROVIDER=deepseek
PLATFORM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Optional BYOK providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional GitHub OAuth login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional production security settings.
SECRET_KEY=replace-with-a-random-secret
TURNSTILE_SECRET_KEY=
BOSON_API_KEY=
